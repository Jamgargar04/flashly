rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Solo se usa si eliges Firebase Storage en lugar de Cloudinary (requiere el plan Blaze).
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function smallJpeg() {
      return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/jpeg');
    }

    // Fotos del momento: solo la dueña sube sus dos fotos.
    match /flashly/{day}/{uid}/{file} {
      allow read: if verified();
      allow write: if verified() && request.auth.uid == uid && file in ['back.jpg', 'front.jpg'] && smallJpeg();
    }

    // Foto de perfil.
    match /flashly/avatars/{uid}/{file} {
      allow read: if verified();
      allow write: if verified() && request.auth.uid == uid && smallJpeg();
    }

    // Portadas de eventos: solo administradores.
    match /flashly/events/{file} {
      allow read: if verified();
      allow write: if verified() && smallJpeg()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
  }
}
