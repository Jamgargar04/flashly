{
  "expo": {
    "name": "Flashly",
    "slug": "flashly",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flashly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mx.edu.utsv.flashly",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "mx.edu.utsv.flashly",
      "adaptiveIcon": {
        "backgroundColor": "#14102A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0B20",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Flashly usa la cámara para tomar tu foto del día."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7C5CFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Flashly usa tus fotos para tu foto de perfil y las portadas de eventos.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cca195dd-c0e0-4562-a2e1-de2a7bc1b65b"
      }
    },
    "owner": "jamingarciadev"
  }
}
